# Copy this file to `.env` and fill in your key:
#
#   cp .env.example .env
#
# `.env` is gitignored. You can also pass the key at build time with
#   --dart-define=NVIDIA_API_KEY=...
#
# Get a key at https://build.nvidia.com (NVIDIA NIM). The app works without a
# bundled key: just paste yours into Settings on first run.
NVIDIA_API_KEY=
